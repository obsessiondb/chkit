<clickhouse>
    <!-- Backfill status queries use clusterAllReplicas('cluster', ...).
         A single local replica exercises the same queries. -->
    <remote_servers>
        <cluster>
            <shard>
                <replica>
                    <host>127.0.0.1</host>
                    <port>9000</port>
                    <user>default</user>
                    <password>chkit-ci</password>
                </replica>
            </shard>
        </cluster>
        <!-- For cluster_for_parallel_replicas: three replicas that are all this
             server, so a query with parallel replicas runs secondary queries
             without a second server. -->
        <parallel_replicas>
            <shard>
                <replica>
                    <host>127.0.0.1</host>
                    <port>9000</port>
                    <user>default</user>
                    <password>chkit-ci</password>
                </replica>
                <replica>
                    <host>127.0.0.1</host>
                    <port>9000</port>
                    <user>default</user>
                    <password>chkit-ci</password>
                </replica>
                <replica>
                    <host>127.0.0.1</host>
                    <port>9000</port>
                    <user>default</user>
                    <password>chkit-ci</password>
                </replica>
            </shard>
        </parallel_replicas>
    </remote_servers>
    <!-- An embedded one-node Keeper, so ReplicatedMergeTree tables work. A
         bare ReplicatedMergeTree replicates under its database and table name,
         since a {uuid} path needs an explicit UUID or ON CLUSTER: give each
         table a new name, or DROP it SYNC, before creating it again. -->
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>127.0.0.1</hostname>
                <port>9234</port>
            </server>
        </raft_configuration>
    </keeper_server>
    <zookeeper>
        <node>
            <host>127.0.0.1</host>
            <port>9181</port>
        </node>
    </zookeeper>
    <default_replica_path>/clickhouse/tables/{database}/{table}/{shard}</default_replica_path>
    <default_replica_name>{replica}</default_replica_name>
    <macros>
        <shard>1</shard>
        <replica>r1</replica>
    </macros>
    <query_log>
        <flush_interval_milliseconds>1000</flush_interval_milliseconds>
    </query_log>
    <!-- The Kafka test produces messages before its consumers attach. -->
    <kafka>
        <consumer>
            <auto_offset_reset>earliest</auto_offset_reset>
        </consumer>
    </kafka>
</clickhouse>
