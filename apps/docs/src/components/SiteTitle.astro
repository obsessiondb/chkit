---
/**
 * Override of Starlight's SiteTitle.
 * Renders the brand wordmark "chkit" (dropping the "Docs" suffix from the
 * configured site title) in the Goldman display face. Styling — font and
 * neutral (non-accent) colour — lives in custom.css (.chk-wordmark).
 */
import { DOCS_PRODUCTS, getDocsProduct } from '../data/docs-products';

const { siteTitleHref, entry, id } = Astro.locals.starlightRoute;
const isSplash = entry.data.template === 'splash';
const product = getDocsProduct(id);
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isBlog = currentPath === '/blog' || currentPath.startsWith('/blog/');
const activeSection = currentPath === '/' ? 'home' : isBlog ? 'blog' : product;
const navItems = [
	{ key: 'home', label: 'Home', href: '/' },
	{ key: 'schema', label: 'Schema Docs', href: DOCS_PRODUCTS.schema.href },
	{ key: 'ingestion', label: 'Sync Docs', href: DOCS_PRODUCTS.ingestion.href },
	{ key: 'blog', label: 'Blog', href: '/blog/' },
];
---

<a href={siteTitleHref} class="site-title sl-flex chk-wordmark">
	<span translate="no">ch-kit</span>
	{!isSplash && <span class="chk-wordmark-badge">{product === 'ingestion' ? 'Sync · beta' : 'Schema'}</span>}
</a>

<nav class="chk-topnav" aria-label="Primary">
	{navItems.map(({ key, label, href }) => (
		<a href={href} aria-current={key === activeSection ? 'true' : undefined}>
			{label}{key === 'ingestion' && <span class="chk-nav-beta">beta</span>}
		</a>
	))}
</nav>

{
	/* Splash pages have no Starlight sidebar/hamburger, so the collapsed nav
	   above has no mobile affordance. Provide one (no-JS <details> menu).
	   Doc pages keep Starlight's own menu button. */
	isSplash && (
		<details class="chk-navmenu">
			<summary aria-label="Menu">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
				</svg>
			</summary>
			<nav class="chk-navmenu-list" aria-label="Primary">
				{navItems.map(({ key, label, href }) => (
					<a href={href} aria-current={key === activeSection ? 'true' : undefined}>
						{label}{key === 'ingestion' && <span class="chk-nav-beta">beta</span>}
					</a>
				))}
			</nav>
		</details>
	)
}

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			white-space: nowrap;
			text-decoration: none;
			min-width: 0;
		}
	}
</style>
