---
import { registryApps, registryStrategyLabel, type RegistryReferenceSection } from '../data/registry';

interface Props {
	name: string;
	section: RegistryReferenceSection;
}

const { name, section } = Astro.props;
const app = registryApps.find((item) => item.name === name);
if (!app) throw new Error(`Unknown registry app: ${name}`);
---

{section === 'overview' && (
	<table>
		<thead><tr><th>Property</th><th>Included behavior</th></tr></thead>
		<tbody>
			<tr><td>Registry app</td><td><code>{app.name}</code> (v{app.version})</td></tr>
			<tr><td>Install command</td><td><code>bunx chkit add {app.name}</code></td></tr>
			<tr><td>Source directory</td><td><code>{app.root}</code></td></tr>
			<tr><td>Authentication</td><td>{app.authentication?.method ?? 'See provider setup'}</td></tr>
			<tr><td>Environment variables</td><td>{app.authentication?.env.map((env, index) => <>{index > 0 && ', '}<code>{env}</code></>) ?? 'See provider setup'}</td></tr>
			<tr><td>ClickHouse</td><td><code>{app.clickhouse}</code></td></tr>
			<tr><td>Coverage</td><td>{app.resources.length} synced resources, {app.views?.length ?? 0} derived views</td></tr>
			<tr><td>Sync strategy</td><td>{app.strategies.map(registryStrategyLabel).join(', ')}</td></tr>
		</tbody>
	</table>
)}
{section === 'authentication' && app.authentication && (
	<>
		<ol>{app.authentication.setup.map((step) => <li>{step}</li>)}</ol>
		<p><a href={app.authentication.documentation}>{app.title} credential setup</a></p>
	</>
)}
{section === 'scopes' && (
	<table>
		<thead><tr><th>Resource</th><th>Required scopes</th></tr></thead>
		<tbody>{app.resources.map((resource) => <tr><td>{resource.title ?? resource.name}</td><td>{resource.scopes.length ? resource.scopes.map((scope, index) => <>{index > 0 && ', '}<code>{scope}</code></>) : 'None'}</td></tr>)}</tbody>
	</table>
)}
{section === 'resources' && (
	<table>
		<thead><tr><th>Resource</th><th>Default ClickHouse table</th><th>Records synced</th><th>API reference</th></tr></thead>
		<tbody>{app.resources.map((resource) => (
			<tr>
				<td>{resource.title ?? resource.name} (<code>{resource.name}</code>)</td>
				<td>{resource.table ? <code>{resource.table}</code> : 'See source schema'}</td>
				<td>{resource.description}</td>
				<td>{resource.endpoints?.map((endpoint, index) => <>{index > 0 && ', '}<a href={endpoint.documentation}><code>{endpoint.method} {endpoint.path}</code></a></>) ?? 'See provider documentation'}</td>
			</tr>
		))}</tbody>
	</table>
)}
{section === 'views' && (
	<table>
		<thead><tr><th>Derived view</th><th>Source resource</th><th>Included projection</th></tr></thead>
		<tbody>{app.views?.map((view) => <tr><td><code>{view.name}</code></td><td><code>{view.source}</code></td><td>{view.description}</td></tr>)}</tbody>
	</table>
)}
{section === 'sync' && app.sync && (
	<table>
		<thead><tr><th>Behavior</th><th>Details</th></tr></thead>
		<tbody>
			<tr><td>Sync</td><td>{app.sync.description}</td></tr>
			<tr><td>Schedule</td><td>{app.sync.schedule}</td></tr>
			<tr><td>Deletions</td><td>{app.sync.deletions}</td></tr>
		</tbody>
	</table>
)}
