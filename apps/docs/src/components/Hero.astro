---
import { LinkButton } from '@astrojs/starlight/components';
import DefaultHero from '@astrojs/starlight/components/Hero.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
const isHome = Astro.locals.starlightRoute.slug === '';
---

{isHome ? (
<div class="hero chk-home-hero">
  <div class="landing-copy">
    <p class="eyebrow">Open-source ClickHouse CLI</p>
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    <div class="landing-actions">
      {actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
        <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
          {text}
          {icon?.html && <Fragment set:html={icon.html} />}
        </LinkButton>
      ))}
    </div>
    <a class="example-link" href="#from-a-schema-to-a-working-data-sync">See the six-step example <span aria-hidden="true">↓</span></a>
    <p class="language-scope"><strong>TypeScript</strong> schema + API sync <span aria-hidden="true">/</span> <a href="/python/overview/"><strong>Python</strong> schema + migrations</a></p>
    <p class="chk-backed"><span>Built by</span> <a href="https://obsessiondb.com">ObsessionDB</a><span aria-hidden="true">·</span><span>Open source · MIT</span></p>
  </div>

  <div class="project-flow" aria-label="Schema definitions and source readers live in your project. chkit migrates the schema and syncs rows into ClickHouse.">
    <div class="flow-header"><span>Your repository</span><span class="flow-file">src/chkit.ts</span></div>
    <div class="flow-inputs">
      <div><span class="flow-index">01</span><strong>Schema</strong><span>Tables · Views · Types</span></div>
      <div><span class="flow-index">02</span><strong>Sources</strong><span>Readers · Mappings · State</span></div>
    </div>
    <div class="flow-connectors" aria-hidden="true"><span>↓</span><span>↓</span></div>
    <div class="flow-runtime"><strong>chkit</strong><span>Review migrations. Run syncs.</span></div>
    <div class="flow-connectors single" aria-hidden="true">↓</div>
    <div class="flow-database"><span class="database-mark" aria-hidden="true">▤</span><div><strong>ClickHouse</strong><span>Tables and views ready to query.</span></div></div>
    <p class="flow-caption">Use your ClickHouse connection from the terminal or CI.</p>
  </div>
</div>
) : <DefaultHero />}

<style>
  .chk-home-hero { display: grid; gap: 2.5rem; align-items: center; padding-block: 2rem 1rem; }
  .landing-copy { min-width: 0; }
  .eyebrow { margin: 0 0 1.1rem; color: var(--accent); font: 0.72rem var(--sl-font-mono); letter-spacing: 0.13em; text-transform: uppercase; }
  h1 { margin: 0; color: var(--ink); font-size: clamp(2.5rem, 4.4vw, 4rem); line-height: 1.08; max-width: 16ch; }
  .tagline { margin: 1.3rem 0 1.6rem; max-width: 48ch; color: var(--ink-2); font-size: 1.1rem; line-height: 1.65; }
  .landing-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .landing-actions :global(.sl-link-button) { margin: 0; font-size: 0.92rem; padding: 0.75rem 1rem; }
  .example-link { display: inline-flex; gap: 0.55rem; margin-top: 0.9rem; color: var(--accent); font-size: 0.8rem; text-decoration: none; }
  .example-link:hover { text-decoration: underline; }
  .language-scope { margin: 1.35rem 0 1rem; font-size: 0.75rem; line-height: 1.8; color: var(--ink-2); }
  .language-scope strong { color: var(--ink); font-weight: 500; }
  .language-scope > span { padding-inline: 0.5rem; color: var(--ink-3); }
  .language-scope a { color: inherit; text-decoration: none; }
  .language-scope a:hover { text-decoration: underline; }
  .chk-backed { flex-wrap: wrap; font-size: 0.64rem; }
  .project-flow { border: 1px solid var(--line-2); background: var(--bg-2); min-width: 0; padding: 1.25rem; }
  .flow-header { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 1.15rem; border-bottom: 1px solid var(--line-2); color: var(--ink-2); font: 0.7rem var(--sl-font-mono); }
  .flow-file { color: var(--accent); }
  .flow-inputs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; margin-top: 1.25rem; }
  .flow-inputs > div { display: flex; flex-direction: column; gap: 0.55rem; padding: 0.95rem 0.75rem; border: 1px solid var(--line-2); }
  .flow-index { color: var(--accent); font: 0.65rem var(--sl-font-mono); }
  .flow-inputs strong { color: var(--ink); font-size: 1.05rem; font-weight: 550; }
  .flow-inputs > div > span:last-child { color: var(--ink-2); font-size: 0.69rem; line-height: 1.6; }
  .flow-connectors { display: grid; grid-template-columns: 1fr 1fr; text-align: center; color: var(--ink-3); font-size: 1.2rem; padding-block: 0.35rem; }
  .flow-connectors.single { display: block; }
  .flow-runtime { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem; border: 1px solid var(--accent); background: var(--accent-dim); }
  .flow-runtime strong { color: var(--accent); font: 600 1.25rem var(--sl-font-mono); }
  .flow-runtime > span { font-size: 0.72rem; color: var(--ink); }
  .flow-database { display: flex; gap: 1rem; align-items: center; padding: 1rem; border: 1px solid var(--line-2); }
  .database-mark { color: var(--accent); font-size: 2rem; line-height: 1; }
  .flow-database > div { display: flex; flex-direction: column; gap: 0.3rem; }
  .flow-database strong { color: var(--ink); font-weight: 550; }
  .flow-database div > span { color: var(--ink-2); font-size: 0.73rem; }
  .flow-caption { margin: 1rem 0 0; color: var(--ink-3); font-size: 0.68rem; text-align: center; }
  @media (min-width: 60rem) { .chk-home-hero { grid-template-columns: 1.2fr 1fr; gap: 3.5rem; padding-block: 3rem 2rem; } }
</style>
