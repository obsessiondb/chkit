---
const apps = [
  { name: 'Attio', logo: '/logos/attio.svg' },
  { name: 'Slack', logo: '/logos/slack.svg' },
  { name: 'Circleback', logo: '/logos/circleback-icon.png' },
  { name: 'GitHub', logo: '/logos/github.svg' },
  { name: 'Google Calendar', logo: '/logos/google-calendar.svg' },
  { name: 'Google Meet', logo: '/logos/google-meet.svg' },
  { name: 'lemlist', logo: '/logos/lemlist.svg' },
  { name: 'Linear', logo: '/logos/linear.svg' },
];

const traces = apps.map((_, index) => {
  const row = Math.floor(index / 2);
  const isLeftColumn = index % 2 === 0;
  const startX = isLeftColumn ? 189 : 350;
  const startY = 104 + row * 111 + (isLeftColumn ? -9 : 9);
  const endY = 242 + index * 8;
  return `M${startX} ${startY} H${isLeftColumn ? 370 : 390} C465 ${startY} 432 ${endY} 550 ${endY}`;
});

const mobileTraces = [
  'M90 242 V268 Q90 282 104 282 H258 Q270 282 270 294 V354',
  'M230 242 V318 Q230 330 242 330 H282 Q294 330 294 342 V354',
  'M370 242 V318 Q370 330 358 330 H318 Q306 330 306 342 V354',
  'M510 242 V268 Q510 282 496 282 H342 Q330 282 330 294 V354',
];
---

<figure class="sync-flow not-content">
  <div class="sync-flow__canvas">
    <span class="sync-flow__source-label" aria-hidden="true">Business apps</span>
    <span class="sync-flow__destination-label" aria-hidden="true">Destination</span>

    <svg class="sync-flow__traces sync-flow__traces--desktop" viewBox="0 0 1000 540" fill="none" aria-hidden="true">
      {traces.map((trace, index) => (
        <>
          <path class="sync-flow__trace" d={trace} />
          <path class="sync-flow__pulse" d={trace} style={`--delay: ${index * -0.7}s`} />
        </>
      ))}
      <path class="sync-flow__trace sync-flow__trace--out" d="M760 270 H798" />
      <path class="sync-flow__arrow" d="m792 263 10 7-10 7" />
      <circle class="sync-flow__junction" cx="523" cy="270" r="3" />
      <circle class="sync-flow__junction" cx="780" cy="270" r="3" />
    </svg>

    <svg class="sync-flow__traces sync-flow__traces--mobile" viewBox="0 0 600 620" fill="none" aria-hidden="true">
      {mobileTraces.map((trace, index) => (
        <>
          <path class="sync-flow__trace" d={trace} />
          <path class="sync-flow__pulse" d={trace} style={`--delay: ${index * -0.9}s`} />
        </>
      ))}
      <path class="sync-flow__trace sync-flow__trace--out" d="M300 446 V514" />
      <path class="sync-flow__arrow" d="m293 506 7 10 7-10" />
      <circle class="sync-flow__junction" cx="300" cy="480" r="3" />
    </svg>

    <ul class="sync-flow__apps" role="list">
      {apps.map(({ name, logo }) => (
        <li class="sync-flow__app">
          <span class="sync-flow__logo-box">
            <img class="sync-flow__app-logo" src={logo} width="44" height="44" alt="" loading="eager" decoding="async" />
          </span>
          <span class="sync-flow__app-name">{name}</span>
        </li>
      ))}
    </ul>

    <div class="sync-flow__hub">
      <span class="sync-flow__wordmark">chkit <strong>Sync</strong></span>
      <span class="sync-flow__detail">Sync API records</span>
    </div>

    <div class="sync-flow__destination">
      <span class="sync-flow__clickhouse-logo-box">
        <img class="sync-flow__clickhouse-logo sync-flow__logo--dark" src="/logos/clickhouse-white.svg" width="60" height="60" alt="" loading="eager" decoding="async" />
        <img class="sync-flow__clickhouse-logo sync-flow__logo--light" src="/logos/clickhouse.svg" width="60" height="60" alt="" loading="eager" decoding="async" />
      </span>
      <span class="sync-flow__destination-text">
        <strong>ClickHouse</strong>
        <span class="sync-flow__detail">Query with SQL</span>
      </span>
    </div>
  </div>
  <figcaption>Business app APIs <span aria-hidden="true">→</span> chkit Sync <span aria-hidden="true">→</span> ClickHouse</figcaption>
</figure>

<style>
  .sync-flow {
    container-type: inline-size;
    margin: 2rem 0;
  }

  .sync-flow__canvas {
    position: relative;
    isolation: isolate;
    aspect-ratio: 1000 / 540;
    overflow: hidden;
    border: 1px solid var(--line-2);
    border-radius: 0.75rem;
    background-color: var(--bg-2);
    background-image:
      radial-gradient(ellipse at 66% 50%, var(--accent-dim), transparent 47%),
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: auto, 5cqi 5cqi, 5cqi 5cqi;
  }

  .sync-flow__source-label,
  .sync-flow__destination-label {
    position: absolute;
    color: var(--txt-muted);
    font-family: var(--sl-font-mono);
    font-size: clamp(0.55rem, 1.2cqi, 0.7rem);
    letter-spacing: 0.09em;
    line-height: 1;
    text-transform: uppercase;
  }

  .sync-flow__source-label {
    left: 4%;
    top: 4.5%;
  }

  .sync-flow__destination-label {
    left: 81%;
    top: 29%;
  }

  .sync-flow__traces {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    color: var(--accent);
  }

  .sync-flow__traces--mobile {
    display: none;
  }

  .sync-flow__trace,
  .sync-flow__pulse,
  .sync-flow__arrow {
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sync-flow__trace {
    stroke-width: 1.7;
    opacity: 0.65;
  }

  .sync-flow__trace--out,
  .sync-flow__arrow {
    stroke-width: 2.3;
    opacity: 1;
  }

  .sync-flow__pulse {
    stroke-width: 3.5;
    stroke-dasharray: 3 190;
    animation: sync-flow-pulse 7s linear var(--delay) infinite;
  }

  .sync-flow__junction {
    fill: currentColor;
  }

  .sync-flow__apps {
    position: absolute;
    top: 10%;
    left: 4%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(4, minmax(0, 1fr));
    gap: 1.2cqi;
    width: 31%;
    height: 80%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sync-flow__app {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75cqi;
    margin: 0;
    padding: 0.8cqi 0.4cqi;
    border: 1px solid var(--line-2);
    border-radius: 0.5rem;
    background: var(--bg-2);
  }

  .sync-flow__logo-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 5.6cqi;
    height: 5.6cqi;
    padding: 0.7cqi;
    border-radius: 0.35rem;
    background: #fff;
  }

  .sync-flow .sync-flow__app-logo {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    border: 0;
    object-fit: contain;
  }

  .sync-flow__app-name {
    max-width: 100%;
    color: var(--txt-strong);
    font-size: clamp(0.6rem, 1.55cqi, 0.85rem);
    font-weight: 500;
    line-height: 1.15;
    text-align: center;
  }

  .sync-flow__hub,
  .sync-flow__destination {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--accent);
    background: var(--bg-2);
  }

  .sync-flow__hub {
    top: 40%;
    left: 55%;
    gap: 0.65cqi;
    width: 21%;
    height: 20%;
    border-radius: 0.6rem;
    box-shadow: 0 0 2rem var(--accent-dim);
  }

  .sync-flow__wordmark {
    color: var(--txt-strong);
    font-size: clamp(1rem, 2.5cqi, 1.7rem);
    letter-spacing: -0.04em;
    line-height: 1;
    white-space: nowrap;
  }

  .sync-flow__wordmark strong {
    font-weight: 600;
  }

  .sync-flow__detail {
    display: block;
    color: var(--txt-soft);
    font-size: clamp(0.5rem, 1.1cqi, 0.7rem);
    line-height: 1.3;
  }

  .sync-flow__destination {
    top: 35%;
    left: 81%;
    gap: 0.8cqi;
    width: 15%;
    height: 30%;
    border-color: var(--line-2);
    border-radius: 0.7rem;
  }

  .sync-flow__clickhouse-logo-box {
    width: 7.5cqi;
    height: 7.5cqi;
  }

  .sync-flow .sync-flow__clickhouse-logo {
    width: 100%;
    height: 100%;
    margin: 0;
    border: 0;
    object-fit: contain;
  }

  .sync-flow__logo--light {
    display: none;
  }

  :global(:root[data-theme='light']) .sync-flow__logo--dark {
    display: none;
  }

  :global(:root[data-theme='light']) .sync-flow__logo--light {
    display: block;
  }

  .sync-flow__destination-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5cqi;
    text-align: center;
  }

  .sync-flow__destination-text strong {
    color: var(--txt-strong);
    font-size: clamp(0.75rem, 1.8cqi, 1.15rem);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .sync-flow figcaption {
    margin-top: 0.75rem;
    color: var(--txt-muted);
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    line-height: 1.6;
    text-align: center;
  }

  .sync-flow figcaption span {
    padding-inline: 0.25rem;
    color: var(--accent);
  }

  @container (max-width: 42rem) {
    .sync-flow__canvas {
      aspect-ratio: 600 / 620;
      background-size: auto, 8cqi 8cqi, 8cqi 8cqi;
    }

    .sync-flow__source-label {
      top: 3%;
      font-size: 0.6rem;
    }

    .sync-flow__destination-label,
    .sync-flow__traces--desktop {
      display: none;
    }

    .sync-flow__traces--mobile {
      display: block;
    }

    .sync-flow__apps {
      top: 7%;
      width: 92%;
      height: 32%;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: repeat(2, minmax(0, 1fr));
      gap: 1.7cqi;
    }

    .sync-flow__app {
      gap: 1cqi;
      padding: 1.2cqi 0.4cqi;
    }

    .sync-flow__logo-box {
      width: 8.8cqi;
      height: 8.8cqi;
      padding: 1cqi;
    }

    .sync-flow__app-name {
      font-size: clamp(0.56rem, 2.3cqi, 0.8rem);
      line-height: 1.15;
    }

    .sync-flow__hub {
      top: 57%;
      left: 33%;
      gap: 1cqi;
      width: 34%;
      height: 15%;
    }

    .sync-flow__wordmark {
      font-size: clamp(1rem, 4cqi, 1.5rem);
    }

    .sync-flow__detail {
      font-size: clamp(0.5rem, 1.9cqi, 0.7rem);
    }

    .sync-flow__destination {
      top: 84%;
      left: 33%;
      width: 34%;
      height: 12%;
      flex-direction: row;
      gap: 1.5cqi;
    }

    .sync-flow__clickhouse-logo-box {
      flex-shrink: 0;
      width: 9cqi;
      height: 9cqi;
    }

    .sync-flow__destination-text strong {
      font-size: clamp(0.7rem, 2.7cqi, 1rem);
    }

    .sync-flow figcaption {
      font-size: 0.6rem;
    }
  }

  @keyframes sync-flow-pulse {
    to {
      stroke-dashoffset: -386;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sync-flow__pulse {
      display: none;
    }
  }
</style>
