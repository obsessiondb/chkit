{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "teamId": "team_VzYIrbcT25TaqBtYUgI4t5Du"
  },
  "tasks": {
    "@chkit/registry#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@chkit/docs#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/registry/**", "$TURBO_ROOT$/scripts/build-registry.ts", "$TURBO_ROOT$/scripts/check-registry-docs.ts", "$TURBO_ROOT$/packages/cli/src/registry/**"],
      "outputs": ["dist/**", "public/r/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "//#infra:up": {
      "cache": false,
      "passThroughEnv": ["CLICKHOUSE_HOST", "CLICKHOUSE_URL"]
    },
    "test": {
      "dependsOn": ["^build", "//#infra:up"],
      "cache": false,
      "passThroughEnv": [
        "CHKIT_E2E_TARGET",
        "CLICKHOUSE_DB",
        "CLICKHOUSE_HOST",
        "CLICKHOUSE_PASSWORD",
        "CLICKHOUSE_URL",
        "CLICKHOUSE_USER"
      ]
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
