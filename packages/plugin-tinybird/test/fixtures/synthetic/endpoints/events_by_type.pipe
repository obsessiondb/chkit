NODE endpoint
SQL >
    %
    SELECT event_type, count() AS events, sum(amount) AS amount
    FROM events
    WHERE event_time >= {{ DateTime(start, '2024-01-01 00:00:00') }}
      AND event_type = {{ String(event_type, 'click') }}
      AND user_id > {{ UInt64(min_user, 0) }}
      AND events.amount >= {{ Float64(min_amount, 1) }}
    GROUP BY event_type
    LIMIT {{ Int32(limit, 100) }}

TYPE endpoint
