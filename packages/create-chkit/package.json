{
  "name": "create-chkit",
  "version": "0.1.2-beta.7",
  "description": "Scaffold a new chkit project from an example",
  "license": "MIT",
  "author": "ObsessionDB",
  "keywords": [
    "clickhouse",
    "schema",
    "migrations",
    "typescript",
    "scaffold",
    "create",
    "chkit"
  ],
  "homepage": "https://chkit.obsessiondb.com",
  "bugs": {
    "url": "https://github.com/obsessiondb/chkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/obsessiondb/chkit.git",
    "directory": "packages/create-chkit"
  },
  "type": "module",
  "bin": {
    "create-chkit": "./dist/bin/create-chkit.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run ../../scripts/check-examples-manifest.ts && tsc -p tsconfig.json && bun run scripts/copy-manifest.ts",
    "dev": "bun run src/bin/create-chkit.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src",
    "test": "bun test src --timeout 60000"
  },
  "dependencies": {
    "@chkit/plugin-obsessiondb": "workspace:*",
    "@clack/prompts": "^1.4.0",
    "commander": "^14.0.3",
    "giget": "^3.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20"
  }
}
