{
  "name": "@chkit/core",
  "version": "0.2.0-beta.15",
  "description": "Schema DSL, config, diff engine, and migration planner for chkit",
  "license": "MIT",
  "author": "ObsessionDB",
  "keywords": [
    "clickhouse",
    "schema",
    "migrations",
    "typescript",
    "database"
  ],
  "homepage": "https://chkit.obsessiondb.com",
  "bugs": {
    "url": "https://github.com/obsessiondb/chkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/obsessiondb/chkit.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema-loader": {
      "source": "./src/schema-loader.ts",
      "types": "./dist/schema-loader.d.ts",
      "default": "./dist/schema-loader.js"
    },
    "./loader": {
      "source": "./src/ts-import.ts",
      "types": "./dist/ts-import.d.ts",
      "default": "./dist/ts-import.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "biome lint src",
    "test": "bun run ../../scripts/infra-up.ts && bun test src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "fast-glob": "^3.3.2",
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@clickhouse/client": "^1.11.0",
    "zod": "^4.3.6"
  }
}
