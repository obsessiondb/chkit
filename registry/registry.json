{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "chkit",
  "homepage": "https://chkit.obsessiondb.com",
  "items": [
    {
      "$schema": "https://ui.shadcn.com/schema/registry-item.json",
      "name": "attio",
      "type": "registry:item",
      "title": "Attio",
      "description": "Editable Attio CRM schemas, raw data readers, typed views, and full-read ingestion pipelines.",
      "dependencies": [
        "@chkit/core@^0.2.0-beta.8",
        "@chkit/plugin-ingest@^0.2.0-beta.8"
      ],
      "files": [
        {
          "path": "attio/README.md",
          "type": "registry:file",
          "target": "src/integrations/attio/README.md"
        },
        {
          "path": "attio/client.ts",
          "type": "registry:file",
          "target": "src/integrations/attio/client.ts"
        },
        {
          "path": "attio/config.ts",
          "type": "registry:file",
          "target": "src/integrations/attio/config.ts"
        },
        {
          "path": "attio/index.ts",
          "type": "registry:file",
          "target": "src/integrations/attio/index.ts"
        },
        {
          "path": "attio/lists/read.ts",
          "type": "registry:file",
          "target": "src/integrations/attio/lists/read.ts"
        },
        {
          "path": "attio/lists/schema.ts",
          "type": "registry:file",
          "target": "src/integrations/attio/lists/schema.ts"
        },
        {
          "path": "attio/members/read.ts",
          "type": "registry:file",
          "target": "src/integrations/attio/members/read.ts"
        },
        {
          "path": "attio/members/schema.ts",
          "type": "registry:file",
          "target": "src/integrations/attio/members/schema.ts"
        },
        {
          "path": "attio/metadata/read.ts",
          "type": "registry:file",
          "target": "src/integrations/attio/metadata/read.ts"
        },
        {
          "path": "attio/metadata/schema.ts",
          "type": "registry:file",
          "target": "src/integrations/attio/metadata/schema.ts"
        },
        {
          "path": "attio/notes/read.ts",
          "type": "registry:file",
          "target": "src/integrations/attio/notes/read.ts"
        },
        {
          "path": "attio/notes/schema.ts",
          "type": "registry:file",
          "target": "src/integrations/attio/notes/schema.ts"
        },
        {
          "path": "attio/pipeline.ts",
          "type": "registry:file",
          "target": "src/integrations/attio/pipeline.ts"
        },
        {
          "path": "attio/records/read.ts",
          "type": "registry:file",
          "target": "src/integrations/attio/records/read.ts"
        },
        {
          "path": "attio/records/schema.ts",
          "type": "registry:file",
          "target": "src/integrations/attio/records/schema.ts"
        },
        {
          "path": "attio/tasks/read.ts",
          "type": "registry:file",
          "target": "src/integrations/attio/tasks/read.ts"
        },
        {
          "path": "attio/tasks/schema.ts",
          "type": "registry:file",
          "target": "src/integrations/attio/tasks/schema.ts"
        }
      ],
      "meta": {
        "chkit": {
          "formatVersion": 1,
          "version": "0.1.1",
          "documentation": "https://chkit.obsessiondb.com/integrations/attio/",
          "logo": "https://chkit.obsessiondb.com/logos/attio.svg",
          "language": "typescript",
          "license": "MIT",
          "chkit": "^0.2.0-beta.8",
          "ingest": "^0.2.0-beta.8",
          "clickhouse": ">=25.3.0",
          "root": "src/integrations/attio",
          "entry": "index.ts",
          "exports": [
            "attio",
            "attioObjectsRaw",
            "attioObjectAttributesRaw",
            "attioRecordsRaw",
            "attioPeople",
            "attioCompanies",
            "attioDeals",
            "attioListsRaw",
            "attioListAttributesRaw",
            "attioEntriesRaw",
            "attioNotesRaw",
            "attioTasksRaw",
            "attioMembersRaw"
          ],
          "resources": [
            {
              "name": "objects",
              "description": "Standard and custom object metadata",
              "scopes": [
                "object_configuration:read"
              ],
              "strategy": "full"
            },
            {
              "name": "object_attributes",
              "description": "Object attribute definitions",
              "scopes": [
                "object_configuration:read"
              ],
              "strategy": "full"
            },
            {
              "name": "records",
              "description": "Current records for all selected objects, including custom attributes",
              "scopes": [
                "object_configuration:read",
                "record_permission:read"
              ],
              "strategy": "full"
            },
            {
              "name": "lists",
              "description": "List metadata",
              "scopes": [
                "list_configuration:read"
              ],
              "strategy": "full"
            },
            {
              "name": "list_attributes",
              "description": "List attribute definitions",
              "scopes": [
                "list_configuration:read"
              ],
              "strategy": "full"
            },
            {
              "name": "entries",
              "description": "List entries and their attribute values",
              "scopes": [
                "list_configuration:read",
                "list_entry:read"
              ],
              "strategy": "full"
            },
            {
              "name": "notes",
              "description": "Plaintext and Markdown notes",
              "scopes": [
                "note:read",
                "object_configuration:read",
                "record_permission:read"
              ],
              "strategy": "full"
            },
            {
              "name": "tasks",
              "description": "Tasks and their links",
              "scopes": [
                "task:read",
                "object_configuration:read",
                "record_permission:read",
                "user_management:read"
              ],
              "strategy": "full"
            },
            {
              "name": "members",
              "description": "Workspace members and actor identities",
              "scopes": [
                "user_management:read"
              ],
              "strategy": "full"
            }
          ],
          "env": {
            "ATTIO_API_TOKEN": ""
          }
        }
      }
    }
  ]
}
