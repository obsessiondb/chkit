{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "github",
  "type": "registry:item",
  "title": "GitHub",
  "description": "Editable GitHub timestamp ingestion with complete issue and pull request context and full stargazer scans.",
  "dependencies": [
    "@chkit/core@^0.2.0-beta.10",
    "@chkit/plugin-ingest@^0.2.0-beta.10"
  ],
  "files": [
    {
      "path": "README.md",
      "type": "registry:file",
      "target": "src/integrations/github/README.md"
    },
    {
      "path": "index.ts",
      "type": "registry:file",
      "target": "src/integrations/github/index.ts"
    },
    {
      "path": "tests/basic.test.ts",
      "type": "registry:file",
      "target": "src/integrations/github/tests/basic.test.ts",
      "role": "test"
    }
  ],
  "meta": {
    "chkit": {
      "formatVersion": 1,
      "version": "0.2.0",
      "documentation": "https://chkit.obsessiondb.com/integrations/github/",
      "logo": "https://chkit.obsessiondb.com/logos/github.svg",
      "language": "typescript",
      "license": "MIT",
      "chkit": "^0.2.0-beta.10",
      "ingest": "^0.2.0-beta.10",
      "clickhouse": ">=25.3.0",
      "root": "src/integrations/github",
      "entry": "index.ts",
      "exports": [
        "githubPipeline",
        "github_issuesRaw",
        "github_stargazersRaw"
      ],
      "resources": [
        {
          "name": "issues",
          "title": "Issues and pull requests",
          "table": "github_issues_raw",
          "description": "Issues and pull requests updated inside a timestamp window, including paginated comments and pull request context.",
          "scopes": [
            "Issues:read",
            "Pull requests:read"
          ],
          "strategy": "timestamp",
          "endpoints": [
            {
              "method": "GET",
              "path": "/repos/{owner}/{repo}/issues",
              "documentation": "https://docs.github.com/en/rest/issues/issues#list-repository-issues"
            }
          ]
        },
        {
          "name": "stargazers",
          "title": "Stargazers",
          "table": "github_stargazers_raw",
          "description": "Repository stargazers with starred_at when the token permits it",
          "scopes": [],
          "strategy": "full",
          "endpoints": [
            {
              "method": "GET",
              "path": "/repos/{owner}/{repo}/stargazers",
              "documentation": "https://docs.github.com/en/rest/activity/starring#list-stargazers"
            }
          ]
        }
      ],
      "env": {
        "GITHUB_TOKEN": ""
      },
      "authentication": {
        "method": "Bearer token",
        "env": [
          "GITHUB_TOKEN"
        ],
        "documentation": "https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens",
        "setup": [
          "Provide GITHUB_TOKEN with read access to the selected resources.",
          "Supply a new access token when the existing token expires."
        ]
      },
      "views": [],
      "sync": {
        "description": "Issues use completed timestamp windows with five-minute overlap; stargazers record successful full-scan completion.",
        "schedule": "Run bunx chkit ingest run --tag provider:github from a scheduler.",
        "deletions": "Deleted issues and removed stars remain stored. Periodic historical reconciliation refreshes child context; absence does not generate tombstones."
      }
    }
  },
  "devDependencies": [
    "@types/bun@^1.2.0"
  ]
}
