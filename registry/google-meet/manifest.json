{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "google-meet",
  "type": "registry:item",
  "title": "Google Meet",
  "description": "Editable Google Meet API ingestion with journaled checkpoints and raw ClickHouse tables.",
  "dependencies": [
    "@chkit/core@^0.2.0-beta.10",
    "@chkit/plugin-ingest@^0.2.0-beta.10"
  ],
  "files": [
    {
      "path": "README.md",
      "type": "registry:file",
      "target": "src/integrations/google-meet/README.md"
    },
    {
      "path": "index.ts",
      "type": "registry:file",
      "target": "src/integrations/google-meet/index.ts"
    },
    {
      "path": "config.ts",
      "type": "registry:file",
      "target": "src/integrations/google-meet/config.ts"
    },
    {
      "path": "client.ts",
      "type": "registry:file",
      "target": "src/integrations/google-meet/client.ts"
    },
    {
      "path": "pipeline.ts",
      "type": "registry:file",
      "target": "src/integrations/google-meet/pipeline.ts"
    },
    {
      "path": "sources/resources.ts",
      "type": "registry:file",
      "target": "src/integrations/google-meet/sources/resources.ts"
    },
    {
      "path": "tests/basic.test.ts",
      "type": "registry:file",
      "target": "src/integrations/google-meet/tests/basic.test.ts",
      "role": "test"
    }
  ],
  "meta": {
    "chkit": {
      "formatVersion": 1,
      "version": "0.2.0",
      "changelog": [
        {
          "version": "0.2.0",
          "changes": [
            "Sync six independent raw resources in one installation pipeline: conferences, participants, participant sessions, recordings, transcript metadata, and individual transcript entries.",
            "Checkpoint fixed conference discovery windows and retain pending conferences until expiry to revisit late artifacts and attendance changes independently of parent updates.",
            "Resume acknowledged discovery and nested child pages with bounded token recovery, sink acknowledgement, and visible expiry gaps.",
            "Keep recording metadata and Drive references without downloading files; keep child rows separate with provider-name join keys and source-scoped row IDs. Migrate legacy transcript identities and embedded entries deliberately when upgrading.",
            "Separate editable installation configuration, injectable HTTP clients, and resource readers; preserve existing conference/transcript/entry stream identities and checkpoint scope."
          ]
        },
        {
          "version": "0.1.0",
          "changes": [
            "Introduce raw conference and transcript ingestion with transcript entries nested in each transcript observation."
          ]
        }
      ],
      "documentation": "https://chkit.obsessiondb.com/integrations/google-meet/",
      "logo": "https://chkit.obsessiondb.com/logos/google-meet.svg",
      "language": "typescript",
      "license": "MIT",
      "chkit": "^0.2.0-beta.10",
      "ingest": "^0.2.0-beta.10",
      "clickhouse": ">=25.3.0",
      "root": "src/integrations/google-meet",
      "entry": "index.ts",
      "exports": [
        "google_meetPipeline",
        "createGoogleMeetPipeline",
        "google_meet_conferencesRaw",
        "google_meet_transcriptsRaw",
        "google_meet_transcriptEntriesRaw",
        "google_meet_participantsRaw",
        "google_meet_participantSessionsRaw",
        "google_meet_recordingsRaw"
      ],
      "resources": [
        {
          "name": "conferences",
          "title": "Conferences",
          "table": "google_meet_conferences_raw",
          "description": "Conference records visible to the access token",
          "scopes": [
            "https://www.googleapis.com/auth/meetings.space.readonly"
          ],
          "strategy": "cursor",
          "endpoints": [
            {
              "method": "GET",
              "path": "/conferenceRecords",
              "documentation": "https://developers.google.com/workspace/meet/api/reference/rest/v2/conferenceRecords/list"
            }
          ]
        },
        {
          "name": "transcripts",
          "title": "Transcripts",
          "table": "google_meet_transcripts_raw",
          "description": "Transcript metadata for discovered and retained pending conferences",
          "scopes": [
            "https://www.googleapis.com/auth/meetings.space.readonly"
          ],
          "strategy": "cursor",
          "endpoints": [
            {
              "method": "GET",
              "path": "/conferenceRecords",
              "documentation": "https://developers.google.com/workspace/meet/api/reference/rest/v2/conferenceRecords/list"
            },
            {
              "method": "GET",
              "path": "/conferenceRecords/{conferenceRecord}/transcripts",
              "documentation": "https://developers.google.com/workspace/meet/api/reference/rest/v2/conferenceRecords.transcripts/list"
            }
          ]
        },
        {
          "name": "transcript-entries",
          "title": "Transcript entries",
          "table": "google_meet_transcript_entries_raw",
          "description": "Individually keyed, paged transcript entries for retained conferences",
          "scopes": [
            "https://www.googleapis.com/auth/meetings.space.readonly"
          ],
          "strategy": "cursor",
          "endpoints": [
            {
              "method": "GET",
              "path": "/conferenceRecords",
              "documentation": "https://developers.google.com/workspace/meet/api/reference/rest/v2/conferenceRecords/list"
            },
            {
              "method": "GET",
              "path": "/conferenceRecords/{conferenceRecord}/transcripts",
              "documentation": "https://developers.google.com/workspace/meet/api/reference/rest/v2/conferenceRecords.transcripts/list"
            },
            {
              "method": "GET",
              "path": "/conferenceRecords/{conferenceRecord}/transcripts/{transcript}/entries",
              "documentation": "https://developers.google.com/workspace/meet/api/reference/rest/v2/conferenceRecords.transcripts.entries/list"
            }
          ]
        },
        {
          "name": "participants",
          "title": "Participants",
          "table": "google_meet_participants_raw",
          "description": "Native attendance records, including signed-in, anonymous, and phone participants",
          "scopes": [
            "https://www.googleapis.com/auth/meetings.space.readonly"
          ],
          "strategy": "cursor",
          "endpoints": [
            {
              "method": "GET",
              "path": "/conferenceRecords",
              "documentation": "https://developers.google.com/workspace/meet/api/reference/rest/v2/conferenceRecords/list"
            },
            {
              "method": "GET",
              "path": "/conferenceRecords/{conferenceRecord}/participants",
              "documentation": "https://developers.google.com/workspace/meet/api/reference/rest/v2/conferenceRecords.participants/list"
            }
          ]
        },
        {
          "name": "participant-sessions",
          "title": "Participant sessions",
          "table": "google_meet_participant_sessions_raw",
          "description": "Individually keyed join/leave sessions with conference and participant names",
          "scopes": [
            "https://www.googleapis.com/auth/meetings.space.readonly"
          ],
          "strategy": "cursor",
          "endpoints": [
            {
              "method": "GET",
              "path": "/conferenceRecords",
              "documentation": "https://developers.google.com/workspace/meet/api/reference/rest/v2/conferenceRecords/list"
            },
            {
              "method": "GET",
              "path": "/conferenceRecords/{conferenceRecord}/participants",
              "documentation": "https://developers.google.com/workspace/meet/api/reference/rest/v2/conferenceRecords.participants/list"
            },
            {
              "method": "GET",
              "path": "/conferenceRecords/{conferenceRecord}/participants/{participant}/participantSessions",
              "documentation": "https://developers.google.com/workspace/meet/api/reference/rest/v2/conferenceRecords.participants.participantSessions/list"
            }
          ]
        },
        {
          "name": "recordings",
          "title": "Recordings",
          "table": "google_meet_recordings_raw",
          "description": "Recording metadata and native Drive destination references; no file downloads",
          "scopes": [
            "https://www.googleapis.com/auth/meetings.space.readonly"
          ],
          "strategy": "cursor",
          "endpoints": [
            {
              "method": "GET",
              "path": "/conferenceRecords",
              "documentation": "https://developers.google.com/workspace/meet/api/reference/rest/v2/conferenceRecords/list"
            },
            {
              "method": "GET",
              "path": "/conferenceRecords/{conferenceRecord}/recordings",
              "documentation": "https://developers.google.com/workspace/meet/api/reference/rest/v2/conferenceRecords.recordings/list"
            }
          ]
        }
      ],
      "env": {
        "GOOGLE_MEET_ACCESS_TOKEN": ""
      },
      "authentication": {
        "method": "OAuth access token",
        "env": [
          "GOOGLE_MEET_ACCESS_TOKEN"
        ],
        "documentation": "https://developers.google.com/workspace/meet/api/guides/authenticate-authorize",
        "setup": [
          "Provide GOOGLE_MEET_ACCESS_TOKEN with read access to the selected resources.",
          "Supply a new access token when the existing token expires."
        ]
      },
      "views": [],
      "sync": {
        "description": "Six independent raw streams use fixed end-time discovery windows and retained conference queues to checkpoint child pages and revisit late artifacts and attendance changes.",
        "schedule": "Run bunx chkit ingest run --tag provider:google-meet from a scheduler.",
        "deletions": "Child streams revisit retained conferences until provider expiry. API expiry does not delete archived raw observations; unfinished work that expires fails visibly."
      }
    }
  },
  "devDependencies": [
    "@types/bun@^1.2.0"
  ]
}
