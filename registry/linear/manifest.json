{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "linear",
  "type": "registry:item",
  "title": "Linear",
  "description": "Editable Linear timestamp ingestion with archived issues and complete paginated comments.",
  "dependencies": [
    "@chkit/core@^0.2.0-beta.10",
    "@chkit/plugin-ingest@^0.2.0-beta.10"
  ],
  "files": [
    {
      "path": "README.md",
      "type": "registry:file",
      "target": "src/integrations/linear/README.md"
    },
    {
      "path": "index.ts",
      "type": "registry:file",
      "target": "src/integrations/linear/index.ts"
    },
    {
      "path": "tests/basic.test.ts",
      "type": "registry:file",
      "target": "src/integrations/linear/tests/basic.test.ts",
      "role": "test"
    }
  ],
  "meta": {
    "chkit": {
      "formatVersion": 1,
      "version": "0.2.0",
      "documentation": "https://chkit.obsessiondb.com/integrations/linear/",
      "logo": "https://chkit.obsessiondb.com/logos/linear.svg",
      "language": "typescript",
      "license": "MIT",
      "chkit": "^0.2.0-beta.10",
      "ingest": "^0.2.0-beta.10",
      "clickhouse": ">=25.3.0",
      "root": "src/integrations/linear",
      "entry": "index.ts",
      "exports": [
        "linearPipeline",
        "linear_issuesRaw"
      ],
      "resources": [
        {
          "name": "issues",
          "title": "Issues",
          "table": "linear_issues_raw",
          "description": "Archived and active issues updated inside a timestamp window, with all accessible comment pages.",
          "scopes": [],
          "strategy": "timestamp",
          "endpoints": [
            {
              "method": "POST",
              "path": "/graphql",
              "documentation": "https://linear.app/developers/graphql"
            }
          ]
        }
      ],
      "env": {
        "LINEAR_API_KEY": ""
      },
      "authentication": {
        "method": "Personal API key",
        "env": [
          "LINEAR_API_KEY"
        ],
        "documentation": "https://linear.app/developers/graphql",
        "setup": [
          "Provide LINEAR_API_KEY with read access to the selected resources.",
          "Keep the API key in the runtime environment and rotate it according to the provider policy."
        ]
      },
      "views": [],
      "sync": {
        "description": "Issues use bounded updatedAt windows, five-minute overlap and whole-window checkpoints after destination acknowledgement.",
        "schedule": "Run bunx chkit ingest run --tag provider:linear from a scheduler.",
        "deletions": "Deleted issues remain stored. Periodic historical reconciliation refreshes comments whose changes may not update the parent issue."
      }
    }
  },
  "devDependencies": [
    "@types/bun@^1.2.0"
  ]
}
