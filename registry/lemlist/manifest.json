{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "lemlist",
  "type": "registry:item",
  "title": "Lemlist",
  "description": "Editable Lemlist ingestion with resumable activity date intervals and full campaign scans.",
  "dependencies": [
    "@chkit/core@^0.2.0-beta.10",
    "@chkit/plugin-ingest@^0.2.0-beta.10"
  ],
  "files": [
    {
      "path": "README.md",
      "type": "registry:file",
      "target": "src/integrations/lemlist/README.md"
    },
    {
      "path": "index.ts",
      "type": "registry:file",
      "target": "src/integrations/lemlist/index.ts"
    },
    { "path": "config.ts", "type": "registry:file", "target": "src/integrations/lemlist/config.ts" },
    { "path": "client.ts", "type": "registry:file", "target": "src/integrations/lemlist/client.ts" },
    { "path": "pipeline.ts", "type": "registry:file", "target": "src/integrations/lemlist/pipeline.ts" },
    { "path": "sources/activities.ts", "type": "registry:file", "target": "src/integrations/lemlist/sources/activities.ts" },
    { "path": "sources/campaigns.ts", "type": "registry:file", "target": "src/integrations/lemlist/sources/campaigns.ts" },
    {
      "path": "tests/basic.test.ts",
      "type": "registry:file",
      "target": "src/integrations/lemlist/tests/basic.test.ts",
      "role": "test"
    }
  ],
  "meta": {
    "chkit": {
      "formatVersion": 1,
      "version": "0.2.0",
      "changelog": [
        {
          "version": "0.2.0",
          "changes": [
            "Sync activities through bounded, overlapping creation-time intervals and advance checkpoints only after all interval pages are acknowledged.",
            "Keep one account pipeline with independently selectable activities and campaigns streams, configurable readers, and shared pagination.",
            "Replay interrupted activity intervals from offset zero and use built-in full-sync completion for campaigns without treating creation time as a modification cursor.",
            "Preserve raw destinations and include fixtures for empty intervals, backfills, and source or destination failures."
          ]
        },
        {
          "version": "0.1.0",
          "changes": [
            "Introduce raw campaigns and activities ingestion."
          ]
        }
      ],
      "documentation": "https://chkit.obsessiondb.com/integrations/lemlist/",
      "logo": "https://chkit.obsessiondb.com/logos/lemlist.svg",
      "language": "typescript",
      "license": "MIT",
      "chkit": "^0.2.0-beta.10",
      "ingest": "^0.2.0-beta.10",
      "clickhouse": ">=25.3.0",
      "root": "src/integrations/lemlist",
      "entry": "index.ts",
      "exports": [
        "lemlistPipeline",
        "createLemlistPipeline",
        "lemlist_activitiesRaw",
        "lemlist_campaignsRaw"
      ],
      "resources": [
        {
          "name": "activities",
          "title": "Activities",
          "table": "lemlist_activities_raw",
          "description": "Outreach activity events",
          "scopes": [],
          "strategy": "timestamp",
          "endpoints": [
            {
              "method": "GET",
              "path": "/activities",
              "documentation": "https://developer.lemlist.com/api-reference/endpoints/activities/get-many-activities"
            }
          ]
        },
        {
          "name": "campaigns",
          "title": "Campaigns",
          "table": "lemlist_campaigns_raw",
          "description": "Campaign metadata",
          "scopes": [],
          "strategy": "full",
          "endpoints": [
            {
              "method": "GET",
              "path": "/campaigns",
              "documentation": "https://developer.lemlist.com/api-reference/endpoints/campaigns/get-many-campaigns"
            }
          ]
        }
      ],
      "env": {
        "LEMLIST_API_KEY": ""
      },
      "authentication": {
        "method": "HTTP Basic API key",
        "env": [
          "LEMLIST_API_KEY"
        ],
        "documentation": "https://developer.lemlist.com/",
        "setup": [
          "Provide LEMLIST_API_KEY with read access to the selected resources.",
          "Keep the API key in the runtime environment and rotate it according to the provider policy."
        ]
      },
      "views": [],
      "sync": {
        "description": "Activities checkpoint completed thirty-day createdAt intervals with one-day overlap; campaigns record successful full-scan completion.",
        "schedule": "Run bunx chkit ingest run --tag provider:lemlist from a scheduler.",
        "deletions": "Removed campaigns and activities remain stored. Historical replay is required for older activity metadata updates outside the overlap."
      }
    }
  },
  "devDependencies": [
    "@types/bun@^1.2.0"
  ]
}
