{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "resolve": {
    "conditions": ["source", "bun"]
  },
  "ignorePatterns": ["examples/**"],
  "entry": ["apps/docs/src/components/*.astro"],
  "duplicates": {
    "ignore": [
      "packages/**/*.test.ts",
      "packages/**/*.spec.ts",
      "packages/**/*.e2e.test.ts"
    ],
    "ignoreImports": true
  },
  "health": {
    "ignore": [
      "packages/**/*.test.ts",
      "packages/**/*.spec.ts",
      "packages/**/*.e2e.test.ts",
      "packages/core/src/model.ts"
    ]
  }
}
